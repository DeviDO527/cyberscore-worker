# Entorno de ejecución

NODE_ENV=development
LOG_LEVEL=info

# Configuración de MySQL

DB_HOST=localhost
DB_PORT=3308
DB_NAME=cyberscore_pyme_test
DB_USER=
DB_PASSWORD=

# Configuración del worker

WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=1

# La API y el worker autorizan el dominio mediante la declaración guardada
# durante su registro. ALLOWED_DOMAINS no sustituye esa autorización.
ALLOWED_DOMAINS=
ALLOW_ANY_PUBLIC_DOMAIN=false

# Nmap: standard (1000 TCP ports) o deep (todos los puertos TCP)
NMAP_SCAN_MODE=standard

# VirusTotal: opcional, sujeto a autorización de uso

VIRUSTOTAL_API_KEY=
